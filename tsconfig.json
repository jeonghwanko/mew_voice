{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules", "android", "ios",
    "babel.config.js", "metro.config.js", "jest.config.js",
    "dist", "output", "store-assets", "store-screenshots",
    "packages/shared/**/*.test.ts",
    "packages/shared/vitest.config.ts"
  ]
}
