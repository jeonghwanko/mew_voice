{
  "name": "@findthem/mobile",
  "version": "1.2.0",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "test": "jest --runInBand",
    "export:android": "expo export --platform android --output-dir dist/android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist/web",
    "test:ci": "node --test deploy/jenkins/mobile-ci.test.mjs",
    "mimi:doctor": "mimi-seed doctor",
    "mimi:plan:android": "mimi-seed deploy --ci jenkins --platform android --ref master --dry-run",
    "mimi:plan:ios": "mimi-seed deploy --ci jenkins --platform ios --ref master --dry-run",
    "build:shared": "tsc -p packages/shared/tsconfig.json",
    "postinstall": "npm run build:shared"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-three/fiber": "^9.3.0",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-gl": "~16.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "three": "^0.180.0",
    "@findthem/shared": "file:packages/shared"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/three": "^0.180.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "mimi-seed": "0.19.13",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE"
}
